{
  "context7": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@upstash/context7-mcp@4.4.2"],
    "env": {}
  },
  "playwright": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@playwright/mcp@0.0.83"],
    "env": {}
  },
  "serena": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "--from", "git+https://github.com/oraios/serena@4c4268f9c0adf8743a75e6dda2ef1fa635f34cc3",
      "serena", "start-mcp-server",
      "--context", "claude-code",
      "--project-from-cwd"
    ],
    "env": {}
  }
}
