{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Edit",
      "Bash(git *)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm test *)",
      "Bash(node --version)",
      "Bash(uv sync*)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock*)",
      "Bash(uv pip *)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(python3 --version)",
      "Bash(pip *)",
      "Bash(gradle *)",
      "Bash(mvn *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo clone *)",
      "Bash(gh run *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh auth status)",
      "Bash(gh label *)",
      "Bash(gh search *)",
      "Bash(gh browse *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(printenv *)",
      "Bash(tree *)",
      "Bash(jq *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(find * -delete)",
      "Bash(find * -exec rm *)",
      "Bash(find * -exec shred *)",
      "Bash(* xargs rm *)",
      "Bash(* xargs shred *)",
      "Bash(* | xargs rm *)",
      "Bash(* | xargs shred *)",
      "Bash(perl * unlink *)",
      "Bash(python -c *os.remove*)",
      "Bash(python -c *os.unlink*)",
      "Bash(python3 -c *os.remove*)",
      "Bash(python3 -c *os.unlink*)",
      "Bash(mv * /dev/null)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(* sed -i * settings.json*)",
      "Bash(* sed -i * .claude.json*)",
      "Bash(* sed -i * .mcp.json*)",
      "Bash(gh api *)",
      "Bash(gh auth token*)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(telnet *)",
      "Bash(ftp *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod 666 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chmod -R 666 *)",
      "Bash(chmod u+s *)",
      "Bash(chmod g+s *)",
      "Bash(chmod +s *)",
      "Bash(chmod 4* *)",
      "Bash(chmod 2* *)",
      "Bash(chmod 6* *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(nohup *)",
      "Bash(crontab *)",
      "Bash(python -c *import*socket*)",
      "Bash(python3 -c *import*socket*)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.npmrc)",
      "Edit(.pip.conf)",
      "Edit(uv.toml)",
      "Edit(.mvn-settings.xml)",
      "Read(/home/node/.ssh/**)",
      "Read(/home/node/.aws/**)",
      "Read(/home/node/.gnupg/**)",
      "Read(/etc/shadow)",
      "Read(/etc/gshadow)",
      "Read(./secrets/**)",
      "WebFetch"
    ],
    "disableBypassPermissionsMode": "disable"
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker *",
      "gh *"
    ],
    "filesystem": {
      "allowWrite": [
        "/workspace",
        "/home/node/.npm",
        "/home/node/.cache",
        "/home/node/.local",
        "/home/node/.m2/repository",
        "/home/node/.gradle",
        "/tmp"
      ],
      "denyWrite": [
        "/home/node/.claude/settings.json",
        "/home/node/.claude/.claude.json",
        "/workspace/.claude/settings.json",
        "/workspace/.claude/settings.local.json",
        "/workspace/.claude/hooks",
        "/workspace/.claude/skills",
        "/workspace/.npmrc",
        "/workspace/.pip.conf",
        "/workspace/uv.toml",
        "/workspace/.mvn-settings.xml",
        "/etc"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg"
      ]
    },
    "network": {
      "allowedDomains": [
        "finance.yahoo.com",
        "query1.finance.yahoo.com",
        "query2.finance.yahoo.com",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "raw.githubusercontent.com",
        "codeload.githubusercontent.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "api.anthropic.com",
        "claude.ai",
        "api.openai.com",
        "openaipublic.blob.core.windows.net",
        "oauth2.googleapis.com",
        "accounts.google.com",
        "www.googleapis.com",
        "context7.com",
        "*.context7.com",
        "cloud.langfuse.com",
        "us.cloud.langfuse.com"
      ],
      "deniedDomains": [
        "gist.githubusercontent.com"
      ],
      "allowLocalBinding": true,
      "allowAllUnixSockets": false
    }
  },

  "autoMode": {
    "environment": [
      "$defaults",
      "DevContainer 内で動作。書き込み可能なのは /workspace とパッケージキャッシュ (~/.npm, ~/.cache, ~/.m2/repository, ~/.gradle) と /tmp のみ",
      "外向き通信は iptables + ipset の許可リストで制限済み。許可外ドメインには到達できない",
      "非 root ユーザー node で動作し、sudo は firewall 初期化専用（Claude は使用しない）",
      "削除操作は種類を問わずユーザー確認が必要というポリシーで運用している"
    ],
    "hard_deny": [
      "$defaults",
      "settings.json / .claude.json / .mcp.json / .claude/hooks / .claude/skills の作成・改変・削除",
      "sandbox / Hooks / firewall の無効化・変更（iptables, ipset, init-firewall.sh, disableAllHooks, dangerouslyDisableSandbox 等）",
      ".env や鍵ファイル（SSH/age/AWS 認証情報）の読み取り・複製・外部送信",
      "サプライチェーン防御設定（.npmrc / .pip.conf / uv.toml / .mvn-settings.xml）の改変",
      "gh api / gh auth token / gh secret / gh variable / gh workflow run / gh ssh-key / gh gpg-key の実行"
    ],
    "soft_deny": [
      "$defaults",
      "ファイル・ディレクトリの削除（rm, unlink, shred, find -delete, xargs rm 等、手段を問わない）",
      "git push --force / git reset --hard / git clean によるコミット履歴・作業内容の破棄",
      "docker のボリューム・イメージ破棄（docker compose down -v, docker volume rm 等）",
      "パッケージクールダウンの迂回（--min-release-age=0, --exclude-newer '0 days', --uploaded-prior-to=P0D）"
    ]
  },

  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "context7",
    "playwright",
    "serena"
  ],

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/block-dangerous.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/supply-chain-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/dockerfile-cooldown-check.sh --pre"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/dockerfile-cooldown-check.sh --pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/lint-on-save.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/dockerfile-cooldown-check.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/gha-security-check.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/dockerfile-cooldown-check.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/gha-security-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/supply-chain-audit.sh"
          },
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/env-plaintext-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/session-guard.sh"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.claude/hooks/permission-denied-log.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/.claude/hooks/langfuse_hook.py"
          }
        ]
      }
    ]
  },

  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "PIP_CONFIG_FILE": "/workspace/.pip.conf"
  }
}
